rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    match /users/{uid} {
      allow create: if isOwner(uid) && request.resource.data.role == 'student';
      allow read: if isOwner(uid) || isTeacher();
      allow update: if (isOwner(uid) && request.resource.data.role == resource.data.role) || isTeacher();
    }
    match /bellwork/{submissionId} {
      allow create: if signedIn()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.status == 'submitted';
      allow read: if signedIn() && (resource.data.studentUid == request.auth.uid || isTeacher());
      allow update: if false;
      allow delete: if isTeacher();
    }
    match /leaderboard/{uid} {
      allow read: if true;
      allow create, update: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.bestStreak is int
        && request.resource.data.bestStreak >= 0
        && request.resource.data.bestStreak <= 1000;
      allow delete: if isOwner(uid) || isTeacher();
    }
  }
}
