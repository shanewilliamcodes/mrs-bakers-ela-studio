rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    // email_verified guard matters: without it, anyone could create a password
    // account with the teacher's (publicly visible) email and inherit the role.
    function isTeacherEmail() {
      return signedIn()
        && request.auth.token.email == 'bakert4@manateeschools.net'
        && request.auth.token.email_verified == true;
    }
    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    match /users/{uid} {
      allow create: if isOwner(uid) && (request.resource.data.role == 'student'
        || (isTeacherEmail() && request.resource.data.role == 'teacher'));
      allow read: if isOwner(uid) || isTeacher();
      allow update: if (isOwner(uid) && request.resource.data.role == resource.data.role)
        || (isOwner(uid) && isTeacherEmail() && request.resource.data.role == 'teacher')
        || isTeacher();
    }
    match /bellwork/{submissionId} {
      allow create: if signedIn()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.submittedAt == request.time;
      allow read: if signedIn() && (resource.data.studentUid == request.auth.uid || isTeacher());
      // A student may fix only TODAY's entry: same owner, unchanged date and
      // original submit time, within 18h of first submitting, and the edit must
      // be timestamped so the teacher can see it was changed.
      allow update: if (signedIn()
        && resource.data.studentUid == request.auth.uid
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.date == resource.data.date
        && request.resource.data.submittedAt == resource.data.submittedAt
        && request.time < resource.data.submittedAt + duration.value(18, 'h')
        && request.resource.data.editedAt == request.time)
        // Teachers may add review marks but cannot alter the student's work.
        || (isTeacher()
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.response == resource.data.response
        && request.resource.data.date == resource.data.date);
      allow delete: if isTeacher();
    }
    // Class rosters for code sign-in. The doc ID IS the class code, so knowing
    // the code is what unlocks the name picker (get only — never list) before
    // a student has an account. Contents are first name + last initial only.
    match /rosters/{code} {
      allow get: if true;
      allow list: if isTeacher();
      allow write: if isTeacher();
    }
    // One doc per claimed roster entry, created by the student who claimed it.
    // Public get lets the sign-in flow tell "new student" from "returning".
    match /claims/{entryId} {
      allow get: if true;
      allow list: if isTeacher();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid;
      allow update: if false;
      allow delete: if isTeacher();
    }
    // Teacher-published settings (today's prompt override, announcements).
    match /settings/{docId} {
      allow read: if true;
      allow write: if isTeacher();
    }
    match /leaderboard/{uid} {
      allow read: if true;
      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.bestStreak is int
        && request.resource.data.bestStreak >= 0
        && request.resource.data.bestStreak <= 1000;
      allow update: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.bestStreak is int
        && request.resource.data.bestStreak >= resource.data.bestStreak
        && request.resource.data.bestStreak <= 1000;
      allow delete: if isOwner(uid) || isTeacher();
    }
  }
}
