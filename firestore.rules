rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isTeacher() { return signedIn() && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher'; }
    match /users/{uid} {
      allow create: if isOwner(uid) && request.resource.data.role == 'student';
      allow read: if isOwner(uid) || isTeacher();
      allow update: if (isOwner(uid) && request.resource.data.role == resource.data.role) || isTeacher();
    }
    match /bellwork/{submissionId} {
      allow create: if signedIn() && request.resource.data.studentUid == request.auth.uid;
      allow read: if signedIn() && (resource.data.studentUid == request.auth.uid || isTeacher());
      allow update: if signedIn() && resource.data.studentUid == request.auth.uid && resource.data.status != 'submitted';
    }
  }
}
