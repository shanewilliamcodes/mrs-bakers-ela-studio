rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isTeacher() {
      return signedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'teacher';
    }
    match /users/{uid} {
      allow create: if isOwner(uid) && request.resource.data.role == 'student';
      allow read: if isOwner(uid) || isTeacher();
      allow update: if (isOwner(uid) && request.resource.data.role == resource.data.role) || isTeacher();
    }
    match /bellwork/{submissionId} {
      allow create: if signedIn()
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.submittedAt == request.time;
      allow read: if signedIn() && (resource.data.studentUid == request.auth.uid || isTeacher());
      // A student may fix only TODAY's entry: same owner, unchanged date and
      // original submit time, within 18h of first submitting, and the edit must
      // be timestamped so the teacher can see it was changed.
      allow update: if (signedIn()
        && resource.data.studentUid == request.auth.uid
        && request.resource.data.studentUid == request.auth.uid
        && request.resource.data.status == 'submitted'
        && request.resource.data.date == resource.data.date
        && request.resource.data.submittedAt == resource.data.submittedAt
        && request.time < resource.data.submittedAt + duration.value(18, 'h')
        && request.resource.data.editedAt == request.time)
        // Teachers may add review marks but cannot alter the student's work.
        || (isTeacher()
        && request.resource.data.studentUid == resource.data.studentUid
        && request.resource.data.response == resource.data.response
        && request.resource.data.date == resource.data.date);
      allow delete: if isTeacher();
    }
    // Teacher-published settings (today's prompt override, announcements).
    match /settings/{docId} {
      allow read: if true;
      allow write: if isTeacher();
    }
    match /leaderboard/{uid} {
      allow read: if true;
      allow create: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.bestStreak is int
        && request.resource.data.bestStreak >= 0
        && request.resource.data.bestStreak <= 1000;
      allow update: if isOwner(uid)
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.bestStreak is int
        && request.resource.data.bestStreak >= resource.data.bestStreak
        && request.resource.data.bestStreak <= 1000;
      allow delete: if isOwner(uid) || isTeacher();
    }
  }
}
